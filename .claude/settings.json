{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(pre-commit:*)",
      "Bash(docker buildx:*)",
      "Bash(docker run:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker stop:*)",
      "Bash(docker rm:*)",
      "Bash(herdr:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(ffmpeg:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws logs:*)",
      "Bash(ffprobe:*)",
      "Bash(gh search:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "mcp__plugin_deploy-on-aws_awsknowledge__aws___search_documentation",
      "mcp__plugin_deploy-on-aws_awsknowledge__aws___read_documentation",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
