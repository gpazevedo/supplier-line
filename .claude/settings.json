      "Bash(git push --no-verify:*)",
      "Bash(cdk:*)",
      "Bash(npx cdk:*)",
      "Bash(pnpm cdk deploy:*)",
      "Bash(pnpm cdk destroy:*)",
      "Bash(gh workflow:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh variable:*)",
      "Bash(gh secret:*)",
      "Bash(aws configure:*)",
      "Bash(aws sso:*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ]
  }
}
