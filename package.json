{
  "name": "supplier-line",
  "version": "0.0.0",
  "description": "English-only voice agent that answers purchase-order status",
  "packageManager": "pnpm@12.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cdk:check": "pnpm --filter infra cdk:check",
    "check:traces": "pnpm --filter traces exec tsx src/cli.ts",
    "reaper:selftest": "pnpm --filter infra reaper:selftest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
