{
  "name": "infra",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1141.0",
    "@aws-sdk/client-ecs": "^3.1141.0",
    "@aws-sdk/client-sns": "^3.1141.0",
    "aws-cdk-lib": "^2.271.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "^2.1143.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "cdk:check": "AWS_EC2_METADATA_DISABLED=true AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null cdk synth --quiet --no-notices -c alertEmail=cdk-check@example.invalid -c expiresAt=$(date -u -d \"+1 hour\" +%Y-%m-%dT%H:%M:%SZ)",
    "reaper:selftest": "cdk deploy --app 'tsx src/reaper/selftest.ts' --output cdk.out.selftest --require-approval never --no-notices"
  }
}
